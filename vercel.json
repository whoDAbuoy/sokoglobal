{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/expire-pools",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reconcile-payouts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/retry-payouts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/retry-webhooks",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/reconcile-escrow",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire-orders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/dispatch-notifications",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
