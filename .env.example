# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave v3 (Dashboard → Settings → API keys / Webhooks)
FLW_SECRET_KEY=             # FLWSECK-… — payments, verify, transfers, refunds
FLW_SECRET_HASH=            # webhook secret hash (checks verif-hash / flutterwave-signature)
FLW_API_BASE_URL=https://api.flutterwave.com/v3
FLW_CHECKOUT_LOGO_URL=      # optional https URL shown on the hosted checkout

# Platform commission on goods value, in basis points (500 = 5%). Default 0.
PLATFORM_FEE_BPS=0

# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token). 16+ chars.
CRON_SECRET=

# Optional: static-IP egress for Flutterwave calls (if your account IP-whitelists transfers)
FLW_OUTBOUND_PROXY_URL=

# Ops alerts → Slack Incoming Webhook (https://hooks.slack.com/services/…)
SLACK_WEBHOOK_URL=

# Map tiles for shipment tracking (use a commercial provider in production)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Content-Security-Policy: report-only (default) | enforce | off
CSP_MODE=report-only
# Optional: send CSP reports to Sentry/report-uri instead of /api/csp-report
# e.g. https://o123.ingest.sentry.io/api/456/security/?sentry_key=abc&sentry_environment=production
CSP_REPORT_URI=
