# Secrets for infrastructure/docker-compose.integrations.yml. Copy to infrastructure/.env.integrations
# (git-ignored) and fill in. Comments stay on their own lines: Docker Compose would read a comment after
# an empty value as the value itself.

# ── n8n ──────────────────────────────────────────────────────────────────────
# Encrypts the credentials stored in n8n; keep it stable. openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Shared HMAC secret: the SAME value as N8N_WEBHOOK_SECRET in the app's .env.local. openssl rand -hex 32
N8N_WEBHOOK_SECRET=
N8N_PUBLIC_URL=http://localhost:5678/
# How n8n reaches the app (here: `npm run dev` on the host)
SOKOGLOBAL_APP_URL=http://host.docker.internal:3000
GENERIC_TIMEZONE=Africa/Nairobi
# Staging behind TLS: N8N_HOST=n8n.example.com, N8N_PROTOCOL=https, N8N_SECURE_COOKIE=true,
# N8N_PUBLIC_URL=https://n8n.example.com/

# ── Twenty CRM ───────────────────────────────────────────────────────────────
# Hex only: it goes into a postgres:// URL as is. openssl rand -hex 32
TWENTY_DB_PASSWORD=
# openssl rand -base64 32
TWENTY_ENCRYPTION_KEY=
TWENTY_SERVER_URL=http://localhost:3001
